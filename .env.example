# Run ./scripts/init.sh to create actual random credentials in .env.
# Never use these descriptive placeholders as deployment secrets.
POSTGRES_PASSWORD=generated-by-init
NUMEN_SECRET_KEY=generated-fernet-key
NUMEN_BROKER_TOKEN=generated-by-init
NUMEN_ADMIN_PASSWORD=generated-by-init
NUMEN_PORT=8788
NUMEN_DASHBOARD_URL=http://localhost:8788
# The ingress (B01). make init adds these to an existing .env and never changes existing lines.
NUMEN_INGRESS_KEY=generated-fernet-key
NUMEN_PUSH_DATABASE_PASSWORD=generated-by-init
NUMEN_AGENT_DATABASE_PASSWORD=generated-by-init
# A P-256 key in base64 DER PKCS#8, and its pin: the hex SHA-256 of its DER SubjectPublicKeyInfo.
NUMEN_AGENT_TLS_KEY=generated-by-init
NUMEN_AGENT_TLS_PIN=generated-by-init
# The push listener is the only port a Public tunnel may reach. Each server's Agent tunnel reaches
# only the agent port. Both are published on 127.0.0.1 only.
NUMEN_PUSH_PORT=8791
NUMEN_AGENT_PORT=8792
# Concurrent jobs: worker slots for any job (plus one reserved for short work) and the
# runner's concurrent container runs. Each agent run may use up to 1 GiB of memory.
NUMEN_WORKER_CONCURRENCY=3
NUMEN_RUNNER_CONCURRENCY=4
# Function analyses one audit runs in parallel (each is one agent run).
NUMEN_AUDIT_CONCURRENCY=3
# Agent backend: herdr runs each agent as an interactive Herdr session the operator can watch,
# steer and chat with from the job page; native runs the one-shot print mode.
NUMEN_AGENT_BACKEND=herdr
