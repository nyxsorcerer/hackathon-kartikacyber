# Run ./scripts/init.sh to create actual random credentials in .env.
# Never use these descriptive placeholders as deployment secrets.
POSTGRES_PASSWORD=generated-by-init
NUMEN_SECRET_KEY=generated-fernet-key
NUMEN_BROKER_TOKEN=generated-by-init
NUMEN_ADMIN_PASSWORD=generated-by-init
NUMEN_PORT=8787
NUMEN_DASHBOARD_URL=http://localhost:8787
# Concurrent jobs: worker slots for any job (plus one reserved for short work) and the
# runner's concurrent container runs. Each agent run may use up to 1 GiB of memory.
NUMEN_WORKER_CONCURRENCY=3
NUMEN_RUNNER_CONCURRENCY=4
